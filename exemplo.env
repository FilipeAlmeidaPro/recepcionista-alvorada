# Copie para .env e preencha. O .env está no .gitignore.
# Nenhuma chave é necessária para rodar os 136 testes nem os 40 cenários
# contra o baseline determinístico — só para falar com um LLM de verdade.

# Groq — free tier sem cartão: console.groq.com/keys
# Cobre o LLM (gpt-oss-120b) e o STT (whisper-large-v3-turbo) com a mesma chave.
# Tetos: 200 mil tokens/dia, 8 mil tokens/minuto, 7200 s de áudio/hora.
GROQ_API_KEY=

# Gemini — free tier sem cartão: aistudio.google.com/apikey
# Teto: 20 requisições por dia, POR MODELO. Serve para experimentar, não para
# rodar a suíte.
GEMINI_API_KEY=
